  "stageInterfaces": {
    "schedule": "getCurrentSlateSchedule({ mode, run_date, run_as_of, providerBudget, providerClient }) -> games with game_pk, scheduled_at, status, teams, doubleheader/game_number, starter evidence, pregame classification.",
    "native": "reconcileNativeIdentity({ mode, runContext, scheduleEvidence, eligibleGamePks, db, dmlCap, checkpoint }) -> game/player insert/reuse/conflict plan and live write counts only in LIVE_EXECUTE.",
    "raw": "reconcileCurrentSlateStatcast({ mode, runContext, eligibleGamePks, dependencyDates, cachePolicy, statcastClient, db, dmlCap, checkpoint }) -> source identities, present/missing/duplicates/unexpected, insert plan, provider accounting.",
    "feature": "refreshCurrentSlateFeatures({ mode, runContext, targetGamePks, runAsOf, db, perDomainCaps, checkpoint }) -> snapshot reuse/insert plan and target-game-only daily feature plan.",
    "starter": "classifyStarterReadiness({ gameSet, scheduleStarterEvidence, featureEvidence, runAsOf }) -> CONFIRMED/PROBABLE/UNKNOWN/CHANGED with reason and source evidence.",
    "inference": "inferMoneyline({ gamePk, featureVector76, runAsOf, champion, modelArtifact }) -> probabilities, input digest, range audit, no persistence.",
    "predictionPersistence": "persistPredictions({ mode, runContext, predictions, eligibleGamePks, db, dmlCap, checkpoint }) -> insert/reuse/conflict.",
    "odds": "acquireMoneylineOdds({ mode, sport:'baseball_mlb', market:'h2h', oddsFormat:'american', providerBudget, oddsClient, injectedEvidence }) -> response, digest, acquired_at, call accounting.",
    "market": "normalizeMarketEvidence(), matchMarketEvents(), classifyMarketPersistence(), persistMarketEvidence() split by function with eligibleGamePks, runAsOf, mapping/observation caps and mode.",
    "value": "calculateValue(), classifyValuePersistence(), persistValue() using certified same-book no-vig/edge/unit-EV math.",
    "officialPickPolicy": "evaluateOfficialPickPolicy({ candidate, marketStats, starterState, gameStart, runAsOf, policyVersion }) -> OFFICIAL_PICK_ELIGIBLE/VALUE_CANDIDATE/WATCHLIST/BLOCKED with codes.",
    "officialPickPersistence": "persistOfficialPicks({ mode, runContext, policyOutputs, eligibleGamePks, db, cap, checkpoint }) -> insert/reuse/conflict.",
    "board": "readValueBoard({ operatingDate, asOf, db }) -> Official Picks, Value Candidates, Watchlist, Blocked, total, top pick, freshness and stale/partial status."
  },
  "checkpointInterface": {
    "functions": ["createRun", "recordStageStart", "recordPlan", "recordProviderBudgetConsumed", "recordDmlClassification", "recordStageCompletion", "recordStageFailure", "resumeFromFirstIncompleteStage"],
    "idempotencyRule": "completed immutable writes are not repeated; second pass must classify as REUSE_NO_OP before advancing"
  },
  "providerInjectionDesign": {
