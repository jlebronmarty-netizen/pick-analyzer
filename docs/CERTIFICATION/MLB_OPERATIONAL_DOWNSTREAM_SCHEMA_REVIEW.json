  "constraints": [
    {
      "table_name": "pick2_game_predictions",
      "conname": "pick2_game_predictions_away_probability_check",
      "contype": "c",
      "definition": "CHECK (((away_probability IS NULL) OR ((away_probability >= (0)::numeric) AND (away_probability <= (1)::numeric))))"
    },
    {
      "table_name": "pick2_game_predictions",
      "conname": "pick2_game_predictions_deterministic_identity_key",
      "contype": "u",
      "definition": "UNIQUE (deterministic_identity)"
    },
    {
      "table_name": "pick2_game_predictions",
      "conname": "pick2_game_predictions_event_id_fkey",
      "contype": "f",
      "definition": "FOREIGN KEY (event_id) REFERENCES sport_events(id)"
    },
    {
      "table_name": "pick2_game_predictions",
      "conname": "pick2_game_predictions_feature_snapshot_id_fkey",
      "contype": "f",
      "definition": "FOREIGN KEY (feature_snapshot_id) REFERENCES pick2_feature_snapshots(id)"
    },
    {
      "table_name": "pick2_game_predictions",
      "conname": "pick2_game_predictions_game_pk_positive",
      "contype": "c",
      "definition": "CHECK (((game_pk IS NULL) OR (game_pk > 0))) NOT VALID"
    },
    {
      "table_name": "pick2_game_predictions",
      "conname": "pick2_game_predictions_home_probability_check",
      "contype": "c",
      "definition": "CHECK (((home_probability IS NULL) OR ((home_probability >= (0)::numeric) AND (home_probability <= (1)::numeric))))"
    },
    {
      "table_name": "pick2_game_predictions",
      "conname": "pick2_game_predictions_model_version_id_fkey",
      "contype": "f",
      "definition": "FOREIGN KEY (model_version_id) REFERENCES pick2_model_versions(id)"
    },
    {
      "table_name": "pick2_game_predictions",
      "conname": "pick2_game_predictions_pick2_era_check",
      "contype": "c",
      "definition": "CHECK ((pick2_era = 'PICK_2_ERA_V1'::text))"
    },
    {
      "table_name": "pick2_game_predictions",
      "conname": "pick2_game_predictions_pkey",
      "contype": "p",
      "definition": "PRIMARY KEY (id)"
    },
