  "scope": "Read-only stored metadata, no outcome evaluation, no provider request. Counts are coverage upper bounds before pairing and full lineage validation.",
  "queries": {
    "canonical2026": "select market_lineage,count(*) as rows,min(game_date) as first_date,max(game_date) as last_date,count(distinct date_trunc('month',game_date)) as represented_months,count(*) filter(where close_snapshot_at is not null) as timestamp_present,count(*) filter(where seconds_before_start > 0) as positive_seconds_before_start,min(seconds_before_start) as min_seconds_before_start,max(seconds_before_start) as max_seconds_before_start,array_agg(distinct sportsbook) as sportsbook_labels from public.mlb_totals_revisit_market_2026_v1 where game_date <= date '2026-09-18' group by market_lineage order by market_lineage;",
    "raw2026": "select s.provider,s.sportsbook,count(distinct m.game_pk) as games,count(distinct date_trunc('month',g.game_date)) as months,min(g.game_date) as first_game_date,max(g.game_date) as last_game_date from public.mlb_ml_sdi_event_game_map_2026_v1 m join public.mlb_ml_xyear_game_v1 g on g.season=2026 and g.game_pk=m.game_pk join public.sports_odds_snapshots s on s.event_id=m.event_id and s.sport_key='baseball_mlb' and s.market='total' and s.snapshot_time<m.start_time where g.game_date between date '2026-03-01' and date '2026-09-18' and s.line is not null group by s.provider,s.sportsbook order by s.provider,s.sportsbook;",
    "canonical2025": "select market_source_version,source_layers,consensus_method,count(*) as rows,min(game_date) as first_date,max(game_date) as last_date,min(created_at) as first_created_at,max(created_at) as last_created_at from public.mlb_totals_market_2025_v1 group by market_source_version,source_layers,consensus_method order by rows desc;"
  },
