{
  "crons": [
    {
      "path": "/api/cron/mlb-operational",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/mlb-statcast-daily",
      "schedule": "15 10 * * *"
    },
    {
      "path": "/api/cron/mlb-statcast-daily",
      "schedule": "15 12 * * *"
    },
    {
      "path": "/api/cron/mlb-statcast-daily",
      "schedule": "15 14 * * *"
    },
    {
      "path": "/api/cron/nba-current-era-shadow",
      "schedule": "*/30 * * * *"
    }
  ],
  "buildCommand": "node -e \"const ok=Boolean(process.env.NEXT_PUBLIC_SUPABASE_URL&&process.env.SUPABASE_SERVICE_ROLE_KEY); process.exit(ok?0:17)\" && npm run build"
}
