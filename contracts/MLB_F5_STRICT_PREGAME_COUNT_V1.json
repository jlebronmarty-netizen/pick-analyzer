{
  "contract": "MLB_F5_STRICT_PREGAME_COUNT_V1/1.0.0",
  "research_only": true,
  "source_admission": "MLB_F1_STARTER_L5_PREGAME_ADMISSION_V1/1.0.0",
  "target_surface": "public.mlb_f5_ml_revisit_base_v1",
  "development_class": "HISTORICAL_SEEN_DEVELOPMENT",
  "max_development_date": "2026-09-14",
  "architecture": "shared_team_f5_poisson_glm_with_opposing_starter_l5_and_team_context",
  "response": "F5 runs scored by batting team",
  "rows_per_game": 2,
  "predictors": {
    "standardized": [
      "batting_team_win_pct",
      "batting_team_run_diff_pg",
      "batting_team_pyth_win_pct",
      "batting_team_off_ops_proxy",
      "opposing_bullpen_ra9",
      "opposing_starter_l5_k_per_bf",
      "opposing_starter_l5_bb_per_bf",
      "opposing_starter_l5_hits_per_bf",
      "opposing_starter_l5_ip_per_start",
      "opposing_starter_l5_whiff_per_swing",
      "opposing_starter_l5_chase_per_outside_zone",
      "opposing_starter_l5_hard_hit_per_bip"
    ],
    "binary": [
      "is_home_batting_team"
    ]
  },
  "fitting": {
    "schedule": "refit once per calendar month from strictly earlier same-season complete games only; score entire target date before adding outcomes",
    "family": "Poisson",
    "link": "log",
    "standardization": "training team-game rows only; mean/std; std floor 1e-9",
    "l2_lambda": 8,
    "penalize_intercept": false,
    "max_iterations": 30,
    "convergence_tolerance": 1e-8,
    "coefficient_clip": 8,
    "eta_clip": 8
  },
  "probability": {
    "home_runs": "Poisson(lambda_home)",
    "away_runs": "Poisson(lambda_away)",
    "settlement": "F5 tie is push",
    "side_probabilities": "exact independent Poisson convolution over integer runs 0..20 plus tail normalization",
    "confidence": "conditional non-push P(HOME)/(P(HOME)+P(AWAY))"
  },
  "eligibility": {
    "min_training_games": 300,
    "both_starters_exact_l5_required": true,
    "complete_feature_row_required": true
  },
  "selection": {
    "confidence_threshold": 0.75,
    "home_rule": "conditional home>=0.75",
    "away_rule": "conditional away>=0.75"
  },
  "gates": {
    "accuracy": 0.75,
    "min_nonpush_n": 60,
    "min_months": 5,
    "worst_month_accuracy": 0.65
  },
  "tuning": "single frozen configuration; no lambda grid, threshold search, feature subset search, run-cap search or post-result calibration",
  "external": "historical-seen development only; no pristine external claim; no external open unless development gate passes",
  "provider_calls_budget": 0,
  "odds_api_credits_budget": 0,
  "official_picks_writes": 0,
  "apostar_activation": false,
  "production_promotion": false,
  "tracker_modified": false
}
